# Exemplo de variáveis de ambiente para a API Orienta (P4)
# Copie para .env ou exporte no terminal se quiser sobrescrever os padrões:

PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/orientadb
DB_USER=orienta_user
DB_PASSWORD=orienta_secret
DDL_AUTO=validate
SHOW_SQL=true
MAIL_HOST=localhost
MAIL_PORT=1025
